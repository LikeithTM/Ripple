<Window x:Class="Ripple.App.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Ripple.App.Controls"
        Title="Ripple"
        Width="560"
        Height="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="PillBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1EFFFFFF"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootCanvas" Background="Transparent" ClipToBounds="False">
        <!-- GPU-composited concave-ear squircle silhouette -->
        <controls:NotchShellControl x:Name="Shell"/>

        <!-- Rest & Peek glance layer -->
        <Grid x:Name="RestLayer"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Height="32"
              IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="14,0">
                <Ellipse x:Name="RestStatusDot"
                         Width="6" Height="6"
                         Fill="#6C8CFF"
                         Margin="0,0,7,0"/>
                <TextBlock x:Name="RestLeftLabel"
                           Text="Ripple"
                           Foreground="#CBD5E1"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Canvas x:Name="RestEqCanvas"
                        Width="26" Height="14"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"/>
                <TextBlock x:Name="RestRightLabel"
                           Text=""
                           Foreground="#94A3B8"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Live Activity Capsule (Single or Split Dual-Capsule) -->
        <Border x:Name="ActivityLayer"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Height="48"
                Visibility="Collapsed"
                Opacity="0">
            <Grid Margin="14,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="14" Background="#24FFFFFF" Margin="0,0,9,0">
                        <TextBlock x:Name="ActIcon" Text="✦" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" MaxWidth="190">
                        <TextBlock x:Name="ActTitle" Text="Activity" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ActSubtitle" Text="" Foreground="#94A3B8" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="ActProgress" Height="3" Minimum="0" Maximum="1" Visibility="Collapsed" Margin="0,3,0,0"
                                     Background="#22FFFFFF" Foreground="#6C8CFF" BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="ActSecondaryPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="ActPrimaryBtn" Style="{StaticResource PillBtn}" Content="Approve" Visibility="Collapsed" Click="OnActivityPrimaryActionClick" Margin="0,0,4,0"/>
                    <Button x:Name="ActSecondaryBtn" Style="{StaticResource PillBtn}" Content="Deny" Visibility="Collapsed" Click="OnActivitySecondaryActionClick" Margin="0,0,4,0"/>
                    <Border x:Name="SplitCapsuleBadge" Visibility="Collapsed" Background="#22FFFFFF" CornerRadius="12" Padding="8,4" MouseLeftButtonUp="OnSplitBadgeClick" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SplitIcon" Text="⏱" FontSize="11" Foreground="White" Margin="0,0,4,0"/>
                            <TextBlock x:Name="SplitLabel" Text="" FontSize="11" Foreground="#E2E8F0" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Expanded Interactive Control Hub -->
        <Border x:Name="ExpandedLayer"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Padding="16,10,16,12"
                Visibility="Collapsed"
                Opacity="0">
            <Border.Effect>
                <BlurEffect x:Name="ContentBlur" Radius="0"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ContentSlideTransform" Y="0"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Module Rail + Pin / Tuner / Settings -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ModuleTabRail" Orientation="Horizontal"/>
                    </ScrollViewer>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button x:Name="PinBtn" Style="{StaticResource PillBtn}" FontFamily="{StaticResource IconFont}" FontSize="12" ToolTip="Pin open (middle-click)" Content="&#xE718;" Click="OnPinClicked" Margin="0,0,3,0" Width="28"/>
                        <Button Style="{StaticResource PillBtn}" FontFamily="{StaticResource IconFont}" FontSize="12" ToolTip="Command palette (Ctrl+Alt+Space)" Content="&#xE721;" Click="OnPaletteClicked" Margin="0,0,3,0" Width="28"/>
                        <Button Style="{StaticResource PillBtn}" FontFamily="{StaticResource IconFont}" FontSize="12" ToolTip="MotionTuner" Content="&#xE9D9;" Click="OnMotionTunerClicked" Margin="0,0,3,0" Width="28"/>
                        <Button Style="{StaticResource PillBtn}" FontFamily="{StaticResource IconFont}" FontSize="12" ToolTip="Settings" Content="&#xE713;" Click="OnSettingsClicked" Width="28"/>
                    </StackPanel>
                </Grid>

                <!-- Active Module Content with Horizontal Shared-Element Slide -->
                <Border Grid.Row="1" ClipToBounds="True">
                    <ContentPresenter x:Name="ModuleContentHost">
                        <ContentPresenter.RenderTransform>
                            <TranslateTransform x:Name="ModuleSlideTransform" X="0"/>
                        </ContentPresenter.RenderTransform>
                    </ContentPresenter>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
