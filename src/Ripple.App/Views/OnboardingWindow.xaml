<Window x:Class="Ripple.App.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Ripple"
        Width="560"
        Height="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="#F50B0D14" BorderBrush="#446C8CFF" BorderThickness="1.2" CornerRadius="22" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="#6C8CFF" Margin="0,0,8,0"/>
                <TextBlock x:Name="StepBadge" Text="STEP 1 OF 4" Foreground="#6C8CFF" FontSize="11.5" FontWeight="Bold"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="StepIcon" Text="✦" FontSize="40" Foreground="#6C8CFF" Margin="0,0,0,8"/>
                <TextBlock x:Name="StepTitle" Text="One Glance, One Hover, One Click" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock x:Name="StepBody" Text="" Foreground="#CBD5E1" FontSize="14" TextWrapping="Wrap" LineHeight="22"/>
            </StackPanel>

            <Grid Grid.Row="2">
                <Button Content="Skip" HorizontalAlignment="Left" Padding="14,7" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Click="OnSkipClicked" Cursor="Hand"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="TryActionBtn" Content="Test Live Activity" Padding="14,7" Background="#246C8CFF" Foreground="White" BorderThickness="0" Margin="0,0,8,0" Click="OnTryActionClicked" Cursor="Hand"/>
                    <Button x:Name="NextBtn" Content="Next →" Padding="18,7" Background="#6C8CFF" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="OnNextClicked" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
