<Window x:Class="Ripple.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ripple Settings"
        Width="780"
        Height="600"
        WindowStartupLocation="CenterScreen"
        Background="#0F111A"
        Foreground="#F1F5F9"
        TextElement.Foreground="#F1F5F9">
    <Border Background="#0F111A" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl x:Name="Tabs" Background="#161925" BorderBrush="#2A2F42" Foreground="#F1F5F9" TextElement.Foreground="#F1F5F9">
            <!-- 1. General -->
            <TabItem Header="General">
                <StackPanel Margin="16">
                    <TextBlock Text="General &amp; Power" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <CheckBox x:Name="ChkStartup" Content="Start Ripple automatically with Windows" Foreground="White" Margin="0,4" Checked="OnLiveSettingChanged" Unchecked="OnLiveSettingChanged"/>
                    <CheckBox x:Name="ChkFollowMonitor" Content="Follow cursor across monitors (Multi-monitor DPI v2)" Foreground="White" Margin="0,4" Checked="OnLiveSettingChanged" Unchecked="OnLiveSettingChanged"/>
                    <CheckBox x:Name="ChkBatterySaver" Content="Drop to 30 fps on battery power" Foreground="White" Margin="0,4" Checked="OnLiveSettingChanged" Unchecked="OnLiveSettingChanged"/>
                    <CheckBox x:Name="ChkUiSounds" Content="Subtle UI feedback sounds (off by default)" Foreground="White" Margin="0,4" Checked="OnLiveSettingChanged" Unchecked="OnLiveSettingChanged"/>
                    <CheckBox x:Name="ChkLargeTargets" Content="Accessibility: Large target scaling (+12%)" Foreground="White" Margin="0,4" Checked="OnLiveSettingChanged" Unchecked="OnLiveSettingChanged"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Export Settings Bundle..." Padding="12,6" Margin="0,0,8,0" Click="OnExportBundle"/>
                        <Button Content="Import Settings Bundle..." Padding="12,6" Click="OnImportBundle"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- 2. Appearance (Live Preview) -->
            <TabItem Header="Appearance">
                <StackPanel Margin="16">
                    <TextBlock Text="Notch Geometry &amp; Theme (Live Preview on Notch)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Layout Style" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbLayout" Grid.Column="1" SelectionChanged="OnLiveSelectionChanged">
                            <ComboBoxItem Content="Notch (Attached + Concave Ears)"/>
                            <ComboBoxItem Content="Floating Island (Rounded Pill)"/>
                            <ComboBoxItem Content="Full Bar (Desktop Strip)"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Placement Anchor" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbAnchor" Grid.Column="1" SelectionChanged="OnLiveSelectionChanged">
                            <ComboBoxItem Content="Top Center"/>
                            <ComboBoxItem Content="Top Left"/>
                            <ComboBoxItem Content="Top Right"/>
                            <ComboBoxItem Content="Bottom Center"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Theme" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbTheme" Grid.Column="1" SelectionChanged="OnLiveSelectionChanged">
                            <ComboBoxItem Content="True Black OLED"/>
                            <ComboBoxItem Content="Liquid Glass"/>
                            <ComboBoxItem Content="Adaptive Album Art"/>
                            <ComboBoxItem Content="Neon Aurora"/>
                            <ComboBoxItem Content="High Contrast"/>
                        </ComboBox>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                        <TextBlock Text="Rest Width (px)" Width="160"/>
                        <Slider x:Name="SldRestWidth" Width="220" Minimum="120" Maximum="340" ValueChanged="OnLiveSliderChanged"/>
                        <TextBlock x:Name="LblRestWidth" Width="50" Margin="8,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                        <TextBlock Text="Rest Thickness (px)" Width="160"/>
                        <Slider x:Name="SldRestHeight" Width="220" Minimum="22" Maximum="48" ValueChanged="OnLiveSliderChanged"/>
                        <TextBlock x:Name="LblRestHeight" Width="50" Margin="8,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                        <TextBlock Text="Concave Ear Radius" Width="160"/>
                        <Slider x:Name="SldEarRadius" Width="220" Minimum="4" Maximum="18" ValueChanged="OnLiveSliderChanged"/>
                        <TextBlock x:Name="LblEarRadius" Width="50" Margin="8,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                        <TextBlock Text="Horizontal Offset X" Width="160"/>
                        <Slider x:Name="SldOffsetX" Width="220" Minimum="-400" Maximum="400" ValueChanged="OnLiveSliderChanged"/>
                        <TextBlock x:Name="LblOffsetX" Width="50" Margin="8,0,0,0"/>
                    </StackPanel>

                    <CheckBox x:Name="ChkGlowEdge" Content="Dynamic glow edge &amp; aura" Foreground="White" Margin="0,8,0,2" Checked="OnLiveSettingChanged" Unchecked="OnLiveSettingChanged"/>
                    <CheckBox x:Name="ChkAurora" Content="Aurora gradient shimmer" Foreground="White" Margin="0,2" Checked="OnLiveSettingChanged" Unchecked="OnLiveSettingChanged"/>
                </StackPanel>
            </TabItem>

            <!-- 3. Behaviour -->
            <TabItem Header="Behaviour">
                <StackPanel Margin="16">
                    <TextBlock Text="Hover, Timing &amp; Smart Visibility" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Hover Intent Delay (ms)" Width="180"/>
                        <Slider x:Name="SldIntentDelay" Width="220" Minimum="0" Maximum="400" ValueChanged="OnLiveSliderChanged"/>
                        <TextBlock x:Name="LblIntentDelay" Width="50" Margin="8,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Collapse Grace Delay (ms)" Width="180"/>
                        <Slider x:Name="SldGraceDelay" Width="220" Minimum="80" Maximum="600" ValueChanged="OnLiveSliderChanged"/>
                        <TextBlock x:Name="LblGraceDelay" Width="50" Margin="8,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Proximity Peek Radius (px)" Width="180"/>
                        <Slider x:Name="SldProximity" Width="220" Minimum="0" Maximum="80" ValueChanged="OnLiveSliderChanged"/>
                        <TextBlock x:Name="LblProximity" Width="50" Margin="8,0,0,0"/>
                    </StackPanel>

                    <CheckBox x:Name="ChkHideFullscreen" Content="Auto-hide in fullscreen games &amp; videos" Foreground="White" Margin="0,8,0,2" Checked="OnLiveSettingChanged" Unchecked="OnLiveSettingChanged"/>
                    <CheckBox x:Name="ChkCollisionDodge" Content="Dodge away when cursor approaches window title-bar buttons/tabs" Foreground="White" Margin="0,2" Checked="OnLiveSettingChanged" Unchecked="OnLiveSettingChanged"/>
                    <CheckBox x:Name="ChkFocusAssist" Content="Respect Windows Focus Assist / Do Not Disturb" Foreground="White" Margin="0,2" Checked="OnLiveSettingChanged" Unchecked="OnLiveSettingChanged"/>
                    <CheckBox x:Name="ChkContextMorph" Content="Context-aware module morphing (music/timer/agent priority)" Foreground="White" Margin="0,2" Checked="OnLiveSettingChanged" Unchecked="OnLiveSettingChanged"/>
                    <CheckBox x:Name="ChkReducedMotion" Content="Reduced motion (quick fade without spring overshoot)" Foreground="White" Margin="0,2" Checked="OnLiveSettingChanged" Unchecked="OnLiveSettingChanged"/>
                </StackPanel>
            </TabItem>

            <!-- 4. Modules -->
            <TabItem Header="Modules">
                <StackPanel Margin="16">
                    <TextBlock Text="Enable / Disable &amp; Reorder Modules" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ListBox x:Name="ModulesList" Height="280" Background="#10131C" Foreground="White" BorderBrush="#2A2F42"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Toggle Selected" Padding="10,5" Margin="0,0,8,0" Click="OnToggleModule"/>
                        <Button Content="Move Up" Padding="10,5" Margin="0,0,8,0" Click="OnMoveModuleUp"/>
                        <Button Content="Move Down" Padding="10,5" Click="OnMoveModuleDown"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- 5. Shortcuts -->
            <TabItem Header="Shortcuts">
                <StackPanel Margin="16">
                    <TextBlock Text="Keyboard Shortcuts &amp; Gestures" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="• Ctrl + Alt + N : Toggle / Pin Notch open or collapsed" Margin="0,4"/>
                    <TextBlock Text="• Ctrl + Alt + Space : Open Command Palette (apps, math, unit conversion)" Margin="0,4"/>
                    <TextBlock Text="• Ctrl + Left / Right (while open) : Switch modules with slide transition" Margin="0,4"/>
                    <TextBlock Text="• Scroll Wheel over Notch : Adjust Master Volume smoothly" Margin="0,4"/>
                    <TextBlock Text="• Middle-Click on Notch : Pin / Unpin open" Margin="0,4"/>
                    <TextBlock Text="• Right-Click on Notch : Quick Profiles &amp; Settings menu" Margin="0,4"/>
                    <TextBlock Text="• Esc : Collapse pinned notch" Margin="0,4"/>
                </StackPanel>
            </TabItem>

            <!-- 6. Profiles -->
            <TabItem Header="Profiles">
                <StackPanel Margin="16">
                    <TextBlock Text="Workspace &amp; Mood Profiles" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ListBox x:Name="ProfilesList" Height="220" Background="#10131C" Foreground="White" BorderBrush="#2A2F42"/>
                    <Button Content="Activate Selected Profile" Width="190" HorizontalAlignment="Left" Padding="12,6" Margin="0,10,0,0" Click="OnActivateProfile"/>
                </StackPanel>
            </TabItem>

            <!-- 7. Integrations -->
            <TabItem Header="Integrations">
                <StackPanel Margin="16">
                    <TextBlock Text="Local REST/WebSocket API, CLI &amp; AI Agent Hooks" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtApiEndpoint" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,4"/>
                    <TextBlock x:Name="TxtApiToken" Foreground="#CBD5E1" Margin="0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <Button Content="Copy Bearer Token" Padding="10,5" Margin="0,0,8,0" Click="OnCopyApiToken"/>
                        <Button Content="Install Claude/Codex/Gemini Hook Script" Padding="10,5" Click="OnInstallAgentHook"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtPluginsSummary" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>

            <!-- 8. Privacy -->
            <TabItem Header="Privacy">
                <StackPanel Margin="16">
                    <TextBlock Text="Privacy-First Architecture" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="• Zero accounts, zero analytics or background telemetry." Margin="0,3"/>
                    <TextBlock Text="• Clipboard history is encrypted at rest using AES-256-GCM + Windows DPAPI user key." Margin="0,3"/>
                    <TextBlock Text="• Password managers ignored automatically: 1Password, Bitwarden, KeePass, LastPass, Dashlane." Margin="0,3"/>
                    <TextBlock Text="• Local API binds strictly to 127.0.0.1 and requires X-Ripple-Token authentication." Margin="0,3"/>
                    <TextBlock Text="• Network calls only occur on demand when fetching synced lyrics (LRCLIB) or weather (Open-Meteo)." Margin="0,3"/>
                </StackPanel>
            </TabItem>

            <!-- 9. About / Notch Doctor -->
            <TabItem Header="About &amp; Doctor">
                <StackPanel Margin="16">
                    <TextBlock Text="Ripple v1.0.0 — Fluid Windows Notch &amp; Dynamic Island" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox x:Name="TxtDoctorReport" Height="270" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="#0A0C12" Foreground="#34D399" FontFamily="Consolas" FontSize="11.5" Padding="10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Refresh Diagnostics" Padding="10,5" Margin="0,0,8,0" Click="OnRefreshDoctor"/>
                        <Button Content="Replay Onboarding Tour" Padding="10,5" Click="OnReplayTour"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
            </TabControl>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,4">
                <Button Content="Save &amp; Close" Padding="16,7" Background="#6C8CFF" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="OnSaveClose"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
