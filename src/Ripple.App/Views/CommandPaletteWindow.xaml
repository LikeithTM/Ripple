<Window x:Class="Ripple.App.Views.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ripple Command Palette"
        Width="560"
        Height="380"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="OnWindowKeyDown">
    <Border Background="#F20C0E16" BorderBrush="#446C8CFF" BorderThickness="1.2" CornerRadius="18" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="QueryBox"
                     Background="#18FFFFFF"
                     Foreground="White"
                     CaretBrush="White"
                     BorderThickness="0"
                     FontSize="15"
                     Padding="12,10"
                     TextChanged="OnQueryChanged"/>

            <ListBox x:Name="ResultList"
                     Grid.Row="1"
                     Margin="0,10,0,0"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     MouseDoubleClick="OnResultDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <TextBlock Text="{Binding Icon}" FontSize="16" Width="28" Foreground="#6C8CFF" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#94A3B8"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>
